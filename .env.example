# TikClip - Arquivo de Configuração de Ambiente (.env)
# Renomeie para .env e preencha as variáveis necessárias

# Porta do Servidor Web (Padrão: 8585)
PORT=8585
HOST=127.0.0.1

# Chaves de API de IA (Você também pode configurar diretamente na tela de Ajustes da interface Web)
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Modelos Padrão
DEEPSEEK_MODEL=deepseek-chat
GEMINI_MODEL=gemini-2.5-flash

# Caminhos Customizados (Opcional - por padrão o sistema detecta automaticamente no sistema/PATH)
# TIKCLIP_FFMPEG_PATH=C:\caminho\para\ffmpeg.exe
# TIKCLIP_YTDLP_PATH=C:\caminho\para\yt-dlp.exe
# TIKCLIP_DATA_DIR=
# TIKTOK_DOWNLOADS_DIR=
